LoginDialog {
    align: center middle;
}

#login-container {
    width: 64;
    max-width: 90%;
    height: auto;
    min-height: 9;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
}

#login-inner {
    width: 100%;
    height: auto;
    min-height: 6;
    background: $surface;
    padding: 1 2 0 2;
}

#login-status {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

/* Hidden until the device code arrives; the dialog then adds ``login-coded``. */
#login-code,
#login-uri,
#login-open {
    display: none;
}

LoginDialog.login-coded #login-code,
LoginDialog.login-coded #login-uri,
LoginDialog.login-coded #login-open {
    display: block;
}

#login-code {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#login-uri {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#login-buttons > Button {
    margin: 0 1;
}
